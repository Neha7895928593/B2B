# PostgreSQL (Supabase pooler recommended — see Project Settings > Database > Connection pooling)
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=6543
PGDATABASE=postgres

PORT=5001

# Random secret used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Seeded admin account (created/updated automatically on server start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173

# SMTP for sending real emails (password reset, order confirmation, custom requests).
# If left unset, emails are logged instead of sent.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Cloudinary (if/when file storage is wired up)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Gemini AI features
GEMINI_API_KEY=
GEMINI_MODELS=
